<Project>
  <!-- Evaluated after each project file, so project-level properties such as IsTestProject are visible here. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Test names read as sentences (CA1707), tests are not public API (CS1591, CA1515, and so their helpers do not
         validate arguments: CA1062), test data is inline (CA1861), and the fuzz tests use System.Random with fixed
         seeds, for cases that repeat and not for security (CA5394). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1515;CA1062;CA1861;CA5394</NoWarn>
  </PropertyGroup>
</Project>
